---
import Container from "../components/layouts/Container.astro";
import PageTitle from "../components/ui/PageTitle.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const emailUser = "tommy";
const emailDomain = "lastcoolnameleft.com";
---

<BaseLayout
    title="Contact"
    description="Have a question or just want to say hi? Drop me a message."
>
    <Container class="mx-auto max-w-2xl py-12">
        <PageTitle title="Get in Touch" />

        <p class="mt-6 text-lg leading-8">
            Have a question or just want to say hi? Send me an email:
        </p>

        <p class="mt-4 text-center">
            <a
                id="email-link"
                class="inline-block rounded-lg bg-primary px-6 py-3 text-lg font-semibold text-white no-underline transition-colors hover:opacity-90"
                href="#"
            >
                <span id="email-text">Loading...</span>
            </a>
        </p>
    </Container>
</BaseLayout>

<script is:inline define:vars={{ emailUser, emailDomain }}>
    (function () {
        const link = document.getElementById("email-link");
        const text = document.getElementById("email-text");
        const addr = emailUser + "@" + emailDomain;
        link.href = "mailto:" + addr;
        text.textContent = addr;
    })();
</script>
