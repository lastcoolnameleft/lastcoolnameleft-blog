---
import { getCollection } from "astro:content";
import Container from "../components/layouts/Container.astro";
import AboutMeAside from "../components/ui/AboutMeAside.astro";
import ContentGrid from "../components/layouts/sections/ContentGrid.astro";
import FeaturedContent from "../components/layouts/sections/FeaturedContent.astro";
import EmptyState from "../components/ui/EmptyState.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { attachMeta } from "../utils/meta";

const PROJECT_IDS = new Set([
    "2025/2025-lewisville-punkin-chunkin",
    "2025/disco-kilt-a-journey-of-sparkles-leds-and-scottish-pride",
    "2019/roboclippy-combining-20-years-of-internet-rage-into-an-adorable-package",
    "2020/how-i-built-a-super-cool-led-lanyard",
]);

const allPosts = await getCollection("blog", ({ data }) => !data.draft);

const sortedPosts = allPosts.sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const latestPosts = sortedPosts.slice(0, 3).map((post) => attachMeta(post));
const latestProjects = allPosts
    .filter((p) => PROJECT_IDS.has(p.id))
    .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
    .slice(0, 3)
    .map((project) => attachMeta(project));

const featured = allPosts
    .filter((item) => item.data.featured !== undefined)
    .sort((a, b) => (a.data.featured ?? 0) - (b.data.featured ?? 0));

const hasContent =
    featured.length > 0 || latestPosts.length > 0 || latestProjects.length > 0;
---

<BaseLayout
    title="LASTCOOLNAMELEFT"
    description="Journaling of an overly curious maker"
>
    <Container class="py-12">
        <div class="2xl:grid 2xl:grid-cols-[minmax(0,1fr)_18rem] 2xl:gap-8">
            <div class="space-y-24">
                {
                    hasContent ? (
                        <>
                            {featured.length > 0 && (
                                <FeaturedContent items={featured} />
                            )}

                            {latestPosts.length > 0 && (
                                <ContentGrid
                                    title="Latest Posts"
                                    href="/blog"
                                    viewAllText="View all posts →"
                                    items={latestPosts}
                                />
                            )}

                            {latestProjects.length > 0 && (
                                <ContentGrid
                                    title="Latest Projects"
                                    href="/projects"
                                    viewAllText="View all projects →"
                                    items={latestProjects}
                                    class="grid grid-cols-1 gap-8 md:grid-cols-3"
                                />
                            )}
                        </>
                    ) : (
                        <EmptyState
                            title="Nothing here yet..."
                            message="Check back soon for new items!"
                        />
                    )
                }
            </div>

            <div class="hidden 2xl:block">
                <div class="sticky top-32">
                    <AboutMeAside />
                </div>
            </div>
        </div>
    </Container>
</BaseLayout>
